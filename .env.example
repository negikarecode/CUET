# =============================================================================
# CUET AI-PREP: PRODUCTION & LOCAL ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Credentials
# -----------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SERVICE ROLE KEY: SECRET! NEVER expose to client or commit to git.
# Used exclusively in secure server-side routes (cron, webhooks, seeder) to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# -----------------------------------------------------------------------------
# 2. AI Engines (Gemini 2.0 Flash & Groq)
# -----------------------------------------------------------------------------
# Google Gemini API Key for CBT mistake coaching & diagnostic engine
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Groq Cloud API Key for sub-second mistake remediation
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# 3. Razorpay Payment Gateway (Test or Live)
# -----------------------------------------------------------------------------
# Get keys at: https://dashboard.razorpay.com/app/keys
# Use rzp_test_... for staging/testing and rzp_live_... for production
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret configured in Razorpay Dashboard -> Settings -> Webhooks
# Target URL: https://your-domain.com/api/payments/razorpay/webhook
# Events: order.paid, payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# -----------------------------------------------------------------------------
# 4. Background Cron Job Security
# -----------------------------------------------------------------------------
# Secret token used by Vercel Cron or external schedulers to trigger /api/cron/sunday-ritual
# Generate with: openssl rand -hex 32
CRON_SECRET=your_random_32_byte_cron_secret

# Admin-only PYQ ingestion review API. Generate a random secret (for example,
# `openssl rand -hex 32`) and enter the same value on /dashboard/admin/pyq.
PYQ_ADMIN_TOKEN=replace_with_a_long_random_secret

# -----------------------------------------------------------------------------
# 5. Brevo Email & Transactional OTP
# -----------------------------------------------------------------------------
# Brevo API Key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib_your_brevo_api_key_here
BREVO_SENDER_EMAIL=cuetmateofficial@gmail.com
BREVO_SENDER_NAME="CUETMate"
OTP_SECRET=your_random_32_byte_otp_secret

